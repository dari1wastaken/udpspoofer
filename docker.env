# Environment for running udpspoofer in local docker-compose testing 

VERSION="0.3"

# ClickHouse within docker network
DATABASE_HOST="clickhouse"
DATABASE_PORT="9000"
DATABASE="test"
DATABASE_USER="test"
DATABASE_PASSWORD="test"
DATABASE_CLIENT_NAME="udpspoofer-client"

# Channels and batching (from recent changes)
CHANNEL_SIZE="200"

# ClickHouse insert batch size for TCP and UDP
# - UDP baseline is quite small, but might increase when replying
TCP_INSERT_BATCH_SIZE="500"
UDP_PASSIVE_INSERT_BATCH_SIZE="500"
UDP_REACTIVE_INSERT_BATCH_SIZE="500"

# Packet Rate limits (Source IP, Source /24, Endpoint (dst_ip, dst_port))
UDP_IP_LIMIT="50"
UDP_SUBNET_LIMIT="400"
UDP_ENDPOINT_LIMIT="500"

# Time window within which packet rates are applied
UDP_RL_WINDOW_MINUTES="1"

# Blocking time applied on passing rate within time window
UDP_RL_BLOCK_TTL_MINUTES="1"

# Interval between cleanup loop for blocked entries.
# Should be around half of blocking time to avoid over-blocking
UDP_RL_CLEANUP_INTERVAL_MINUTES="3"

LOG_LEVEL=trace