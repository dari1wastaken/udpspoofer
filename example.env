VERSION="0.3"

DATABASE_HOST="localhost"
DATABASE_PORT="9000"
DATABASE="test"
DATABASE_USER="test"
DATABASE_PASSWORD="test"
DATABASE_CLIENT_NAME="udpspoofer-client"

# Channel buffer size for all channels (TCP/UDP queues and outbound)
CHANNEL_SIZE="10000"

# ClickHouse insert batch size for TCP and UDP
INSERT_BATCH_SIZE="50000"

# Packet Rate limits (Source IP, Source /24, Endpoint (dst_ip, dst_port))
# Defaults based on UDP traffic baselines
UDP_IP_LIMIT="50"
UDP_SUBNET_LIMIT="400"
UDP_ENDPOINT_LIMIT="500"

# Time window within which packet rates are applied
UDP_RL_WINDOW_MINUTES="1"

# Blocking time applied on passing rate within time window
UDP_RL_BLOCK_TTL_MINUTES="5"

LOG_LEVEL="info"