VERSION="0.3"

DATABASE_HOST="localhost"
DATABASE_PORT="9000"
DATABASE="test"
DATABASE_USER="test"
DATABASE_PASSWORD="test"
DATABASE_CLIENT_NAME="udpspoofer-client"

# Channel buffer size for all channels (TCP/UDP queues and outbound)
CHANNEL_SIZE="10000"

# ClickHouse insert batch size for TCP and UDP
# - UDP baseline is quite small, but might increase when replying
TCP_PASSIVE_INSERT_BATCH_SIZE="500"
TCP_REACTIVE_INSERT_BATCH_SIZE="50000"
UDP_PASSIVE_INSERT_BATCH_SIZE="500"
UDP_REACTIVE_INSERT_BATCH_SIZE="50000"

# Packet Rate limits (Source IP, Source /24, Endpoint (dst_ip, dst_port))
# Defaults based on UDP traffic baselines
UDP_IP_LIMIT="50"
UDP_SUBNET_LIMIT="150"
UDP_ENDPOINT_LIMIT="500"

# Time window within which packet rates are applied
UDP_RL_WINDOW_MINUTES="1"

# Blocking time applied on passing rate within time window
UDP_RL_BLOCK_TTL_MINUTES="5"

# Interval between cleanup loop ticks
UDP_RL_CLEANUP_INTERVAL_MINUTES="3"

# Every N cleanup ticks, also prune expired rate entries (ipRates/subRates/epRates)
# Cleanup frequency: UDP_RL_CLEANUP_INTERVAL_MINUTES * UDP_ENTRY_CLEANUP_INTERVALS
UDP_ENTRY_CLEANUP_INTERVALS="10"

LOG_LEVEL="info"
# Interval in seconds to log potential packet drops by database channels
STATIC_DROP_LOG_SECS="30"